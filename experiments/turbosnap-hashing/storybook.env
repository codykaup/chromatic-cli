# Source these (set -a; . storybook.env; set +a) to point the harness at storybookjs/storybook.
export TS_REPO_ROOT=/home/user/storybook-src
export TS_STATS=/home/user/storybook-src/code/storybook-static/preview-stats.json
export TS_TSCONFIG=/home/user/storybook-src/code/tsconfig.json
export TS_CONDITIONS=code
export TS_BASE_DIR=code
export TS_CONFIG_DIR=code/.storybook
export TS_STATIC_DIRS=
# story files: *.stories.* or *.mdx anywhere under code/
export TS_STORY_RE='^code/.*(\.stories\.[^/]+|\.mdx)$'
# universe: all source under code/, excluding tests/dist/node_modules/mocks
export TS_SOURCE_RE='^code/'
export TS_EXCLUDE_RE='\.(test|spec)\.[jt]sx?$|/__|/dist/|/node_modules/|vitest'
